# Copy this file to ".env" and add your API key.
# Get a key at https://console.anthropic.com -> API Keys.
# Without a key CVPilot runs in demo mode (rule-based ATS check only).

ANTHROPIC_API_KEY=

# Optional settings
# CLAUDE_MODEL=claude-opus-5-5
# AI_EFFORT=medium          # low | medium | high  (higher = deeper analysis, slower)
# AI_FALLBACKS=off          # disable server-side refusal fallback
# PORT=3000
# HOST=127.0.0.1            # HOST=0.0.0.0 to try it from a phone on the same Wi-Fi
# CVPILOT_DATA_DIR=./data   # where the application tracker stores its JSON file
