{
  "name": "cvpilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered CV optimizer for the Turkish job market: ATS analysis, job-specific CV rewrites, cover letters, application tracker and job matching, built on Claude.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "docx": "^9.5.0",
    "express": "^5.1.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "license": "MIT",
  "author": "omergazi34",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omergazi34/cvpilot.git"
  }
}
